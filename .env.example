# ============================================================
# KETUPAT WhatsApp Order Bot - Backend Environment Variables
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
# Public URL of the frontend admin dashboard (used for CORS)
FRONTEND_URL=http://localhost:5173

# --- Database (Prisma + SQLite for development) ---
DATABASE_URL="file:./dev.db"

# --- JWT Auth ---
# Use a long random string in production, e.g: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# --- Seed Admin (used only by `npm run prisma:seed`) ---
SEED_ADMIN_NAME=Admin KETUPAT
SEED_ADMIN_EMAIL=admin@ketupat.id
SEED_ADMIN_PASSWORD=change-this-password

# --- Fonnte WhatsApp Gateway ---
# Get your token at https://fonnte.com -> Device -> copy "Token"
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
# Optional shared secret you configure yourself and pass as a query string
# on the webhook URL you register in the Fonnte dashboard, e.g:
# https://yourdomain.com/webhook/fonnte?secret=xxxx
# Leave empty to disable this extra check (not recommended in production).
FONNTE_WEBHOOK_SECRET=

# --- Admin notification (for the free "Konsultasi" service) ---
# Real WhatsApp number of the human admin. When a customer picks "Konsultasi",
# the bot notifies this number so the admin can jump into the chat personally.
# Format like the customer numbers: 628xxxxxxxxxx. Leave blank to disable.
ADMIN_WHATSAPP_NUMBER=

# --- Optional stickers (WEBP, sent alongside a few messages for extra flair) ---
# Must be public, direct .webp URLs. Leave blank to skip sending a sticker.
# NOTE: like other attachments, this only works on Fonnte's super/advanced/
# ultra device packages.
STICKER_ORDER_CREATED_URL=
STICKER_PAYMENT_VERIFIED_URL=
STICKER_COMPLETED_URL=

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
