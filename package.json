{
  "name": "ketupat-backend",
  "version": "2.0.0",
  "description": "KETUPAT WhatsApp Order Bot - Backend (Cloudflare Workers + Hono + Prisma/Neon + R2 + Fonnte)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "prisma generate && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:admin": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250910.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "prisma": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.0.0"
  }
}
